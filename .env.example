# Environment Variables — SWASTHYA-SANKET
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.

# ─── DATABASE ──────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/swasthya_sanket?schema=public"

# ─── AUTHENTICATION ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_32_CHAR_RANDOM_STRING"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI PROVIDER ───────────────────────────────────────────────────────────
# Server-side only — NEVER exposed to browser
AI_PROVIDER="gemini"          # gemini | openai | azure-openai
AI_API_KEY="REPLACE_WITH_YOUR_KEY"
AI_MODEL="gemini-2.5-flash"

# ─── APP ───────────────────────────────────────────────────────────────────
APP_ENV="development"         # development | staging | production
APP_VERSION="0.1.0"

# ─── OPTIONAL: SMS / OTP (Phase 2) ─────────────────────────────────────────
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
